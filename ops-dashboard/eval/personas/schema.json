{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimCustomerPersona",
  "type": "object",
  "required": ["id", "display_name", "language", "intent", "system_prompt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "display_name": { "type": "string" },
    "language": { "type": "string", "description": "BCP-47 or free text e.g. bs-BA" },
    "intent": {
      "type": "string",
      "enum": ["soft_yes", "hard_no", "price_objector", "dnc", "callback", "confused"]
    },
    "city": { "type": "string" },
    "system_prompt": { "type": "string" },
    "opening_line": { "type": "string" },
    "max_turns": { "type": "integer", "default": 20 },
    "notes": { "type": "string" }
  }
}
