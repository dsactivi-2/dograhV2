# Dograh instance base URL (no trailing slash)
# Self-hosted example: http://localhost:3000
# Cloud: https://app.dograh.com
DOGRAH_API_URL=http://localhost:3000

# API key from Dograh → /api-keys (sent as X-API-Key)
DOGRAH_API_KEY=

# Force mock/demo data even if a key is set (true/false)
# When DOGRAH_API_KEY is empty, mock mode is on by default.
DOGRAH_USE_MOCK=true

# --- Langfuse Metrics API (optional; Dograh only returns masked keys) ---
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# --- Offline eval gates (Python) ---
# EVAL_DEEPEVAL=false
# EVAL_RAGAS=false
# EVAL_PROMPTFOO=true

# --- Sim customer V2 (future gateway) ---
# SIM_CUSTOMER_PHONE=+387...
# SIM_CUSTOMER_GATEWAY_URL=
